@{
    ViewData["Title"] = "Students";
}


<h2>@ViewBag.TitleIndex</h2>
<p><em>@ViewData["SubTitleStudentList"]</em></p>

@if(Model != null && Model.Count > 0)
{
    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            @{int i = 1;}
            @foreach (var student in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@student</td>
                </tr>
                i++;
            }
        </tbody>
    </table>
}
else
{
    <p>No Studens found</p>
}


